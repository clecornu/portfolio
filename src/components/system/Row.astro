---
// One row on the system pages: the name and a note in the first column, the
// content in the other three.
import Text from "@/components/fundations/elements/Text.astro";
interface Props {
  name: string;
  text?: string;
}
const { name, text } = Astro.props;
---

<article class="py-12 border-t border-muted">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-4 items-start">
    <div>
      <Text tag="h2" variant="textLG" class="text-foreground leading-tight font-medium text-pretty">
        {name}
      </Text>
      {
        text && (
          <Text tag="p" variant="textSM" class="mt-2 text-muted-foreground">
            {text}
          </Text>
        )
      }
    </div>
    <div class="min-w-0 lg:col-span-3">
      <slot />
    </div>
  </div>
</article>
