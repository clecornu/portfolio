---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Row from "@/components/system/Row.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
const variants = [
  { name: "Default", value: "default", text: "Ink, for the main action of a block." },
  { name: "Muted", value: "muted", text: "A grey fill, for a quieter second action." },
];
const sizes = [
  { name: "XXS", value: "xxs", icon: "sm" },
  { name: "XS", value: "xs", icon: "sm" },
  { name: "SM", value: "sm", icon: "base" },
  { name: "Base", value: "base", icon: "base" },
  { name: "MD", value: "md", icon: "lg" },
  { name: "LG", value: "lg", icon: "xl" },
  { name: "XL", value: "xl", icon: "xl" },
];
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col">
      {
        variants.map((variant) => (
          <Row name={variant.name} text={variant.text}>
            <div class="flex flex-wrap items-end gap-3">
              {sizes.map((size) => (
                <Button size={size.value} variant={variant.value}>
                  {`${variant.name} ${size.name}`}
                </Button>
              ))}
            </div>
            <div class="flex flex-wrap items-end gap-3 mt-6">
              {sizes.map((size) => (
                <Button size={size.value} variant={variant.value} iconOnly aria-label={`${variant.name} ${size.name} icon`}>
                  <Plus slot="icon" size={size.icon} />
                </Button>
              ))}
            </div>
          </Row>
        ))
      }
    </div>
  </Wrapper>
</section>
