---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const variants = [
  "display6XL",
  "display5XL",
  "display4XL",
  "display3XL",
  "display2XL",
  "displayXL",
  "displayLG",
  "displayMD",
  "displaySM",
  "displayXS",
  "textXL",
  "textLG",
  "textBase",
  "textSM",
  "textXS",
];
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col">
      {
        variants.map((variant) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text tag="p" variant="textXS" class="text-muted-foreground">
                {variant}
              </Text>
              <Text
                tag="p"
                variant={variant}
                class:list={[
                  "text-foreground lg:col-span-3 text-pretty",
                  variant.startsWith("display") && "font-semibold leading-snug tracking-tighter",
                ]}
              >
                Code. Design. Strategy.
              </Text>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
