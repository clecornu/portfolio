---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Row from "@/components/system/Row.astro";
const styles = [
  { name: "Display 6XL", variant: "display6XL", display: true },
  { name: "Display 5XL", variant: "display5XL", display: true },
  { name: "Display 4XL", variant: "display4XL", display: true },
  { name: "Display 3XL", variant: "display3XL", display: true },
  { name: "Display 2XL", variant: "display2XL", display: true },
  { name: "Display XL", variant: "displayXL", display: true },
  { name: "Display LG", variant: "displayLG", use: "The intro and the 404", display: true },
  { name: "Display MD", variant: "displayMD", display: true },
  { name: "Display SM", variant: "displaySM", use: "Work and project titles", display: true },
  { name: "Display XS", variant: "displayXS", display: true },
  { name: "Text XL", variant: "textXL", use: "Section headings", display: true },
  { name: "Text LG", variant: "textLG", use: "Education and talk titles", display: false, semibold: true },
  { name: "Text Base", variant: "textBase", display: false },
  { name: "Text SM", variant: "textSM", use: "Descriptions and section labels", display: false },
  { name: "Text XS", variant: "textXS", use: "Years, categories, the navigation and the footer", display: false },
];
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col">
      {
        styles.map((style) => (
          <Row name={style.name} text={style.use}>
            <Text
              tag="p"
              variant={style.variant}
              class:list={["truncate text-foreground", style.display && "font-semibold leading-snug tracking-tighter", style.semibold && "font-semibold leading-tight"]}
            >
              Creative technologist, Helsinki
            </Text>
          </Row>
        ))
      }
    </div>
  </Wrapper>
</section>
