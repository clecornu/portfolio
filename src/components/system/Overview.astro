---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const groups = [
  {
    category: "Static",
    title: "Landing pages",
    links: [
      { title: "Home", url: "/" },
      { title: "404", url: "/404" },
    ],
  },
  {
    category: "Static",
    title: "System",
    links: [
      { title: "Colors", url: "/system/colors" },
      { title: "Typography", url: "/system/typography" },
      { title: "Buttons", url: "/system/buttons" },
      { title: "Links", url: "/system/links" },
    ],
  },
  {
    category: "Static",
    title: "Resources",
    links: [
      { title: "License", url: "https://lexingtonthemes.com/legal/license" },
      { title: "Documentation", url: "https://lexingtonthemes.com/documentation" },
    ],
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col">
      {
        groups.map((group) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text tag="p" variant="textXS" class="text-muted-foreground uppercase">
                {group.category}
              </Text>
              <Text tag="h2" variant="textLG" class="text-foreground leading-tight font-medium tracking-tight text-pretty">
                {group.title}
              </Text>
              <ul class="flex flex-col gap-2 lg:col-span-2">
                {group.links.map((link) => (
                  <li>
                    <a href={link.url} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
