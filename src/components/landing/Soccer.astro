---
// Assets
import { Image } from "astro:assets";
import one from "@/images/soccer/soccer-1.webp";
import two from "@/images/soccer/soccer-2.webp";
import three from "@/images/soccer/soccer-3.webp";
import four from "@/images/soccer/soccer-4.webp";
import five from "@/images/soccer/soccer-5.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArrowLeft from "@/components/fundations/icons/ArrowLeft.astro";
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";

const photos = [
  { src: one, alt: "Carson in a training kit, standing in a stadium corridor." },
  { src: two, alt: "Carson and his dad after a match, a cut above Carson’s eye." },
  { src: three, alt: "Close up of a St. Louis City SC training top." },
  { src: four, alt: "Carson striking a ball on a pitch in front of red tiled houses." },
  { src: five, alt: "Carson on the field during an MLS NEXT match." },
];

const story = [
  "Soccer was my first obsession. From the time I was 5, all I wanted was to play professionally, and after training 3 hours a day for years, I eventually got scouted by both LA galaxy, and ST. Louis City, two MLS Academies. After playing well at both, neither offered me a spot.",
  "The rejections broke me, I remember driving back from LA and not saying a word the entire time. I felt sorry for myself, questioning why this happened to me. Then, my dad asked me a question, did I want to sit and feel sorry for myself, or did I want to double down and work even harder, so when the next opportunity came, I was ready? I went out and trained right after.",
  "I ended up traveling to Spain on my own, playing with Real Sporting de Gijón for a month, then coming back again later to play with a team in Valencia. Finally, last year, I got a few offers to play in college, including a Division 1 offer. However, another obsession had been creeping up, and that was my obsession with building. I decided to turn down the offer to focus full time on building.",
  "Soccer has shaped me into who I am today, I’ve learned to love rejection, enjoy the process and the work that comes with it, and that when something has to happen, I make it happen. These lessons are a big part of why I want to be at the Academy. I do my best work around others that constantly push my limits, and the Academy is going to be full of the best, smartest, most hard working young founders. I need to be a part of it.",
];
---

<section class="scroll-mt-32" id="soccer">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex items-end justify-between gap-4">
      <Text
        tag="h2"
        variant="displaySM"
        class="text-foreground leading-tight font-medium tracking-tight text-pretty"
      >
        Soccer
      </Text>
      <div class="flex gap-2">
        <Button variant="muted" size="sm" iconOnly aria-label="Previous photo" class="disabled:opacity-40 disabled:pointer-events-none" data-carousel-prev>
          <ArrowLeft slot="icon" class="size-4" />
        </Button>
        <Button variant="muted" size="sm" iconOnly aria-label="Next photo" class="disabled:opacity-40 disabled:pointer-events-none" data-carousel-next>
          <ArrowRight slot="icon" class="size-4" />
        </Button>
      </div>
    </div>

    <div class="mt-12" role="region" aria-roledescription="carousel" aria-label="Soccer photos" data-carousel>
      <ul
        class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto overscroll-x-contain px-4 [scrollbar-width:none] lg:-mx-8 lg:scroll-px-8 lg:gap-6 lg:px-8 [&::-webkit-scrollbar]:hidden"
        data-carousel-track
      >
        {
          photos.map((photo, i) => (
            <li class="shrink-0 snap-start" aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
              <Image
                src={photo.src}
                alt={photo.alt}
                width={photo.src.width}
                height={photo.src.height}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="h-80 w-auto rounded-[20px] object-cover lg:h-98"
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 flex flex-col gap-5">
      {story.map((paragraph) => <Text tag="p" variant="textSM" class="text-foreground">{paragraph}</Text>)}
    </div>
  </Wrapper>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const section = carousel.closest("section")!;
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]")!;
    const prev = section.querySelector<HTMLButtonElement>("[data-carousel-prev]")!;
    const next = section.querySelector<HTMLButtonElement>("[data-carousel-next]")!;
    const slides = [...track.children] as HTMLElement[];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const inset = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    const offset = (slide: HTMLElement) => slide.offsetLeft - track.offsetLeft - inset();

    const go = (direction: 1 | -1) => {
      const x = track.scrollLeft;
      const target =
        direction === 1
          ? slides.find((slide) => offset(slide) > x + 4)
          : [...slides].reverse().find((slide) => offset(slide) < x - 4);
      track.scrollTo({ left: target ? offset(target) : direction === 1 ? track.scrollWidth : 0, behavior: reduce.matches ? "auto" : "smooth" });
    };
    const sync = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  });
</script>
