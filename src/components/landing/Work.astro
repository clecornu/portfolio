---
// Assets
import { Image } from "astro:assets";
import one from "@/images/work/one.webp";
import two from "@/images/work/two.webp";
import three from "@/images/work/three.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const featuredProjects = [
  {
    year: "2026",
    title: "Tuisku",
    description:
      "An electric vehicle platform built on modular hardware, live telemetry and software defined systems, designed to stay efficient as the fleet grows.",
    category: "Electric vehicles",
    image: one,
    imageAlt:
      "Silver electric saloon in a bright concrete studio, lit by a tall window.",
  },
  {
    year: "2025",
    title: "Kulku",
    description:
      "A subscription for electric bikes with live diagnostics, maintenance that books itself and a commute that starts in two taps.",
    category: "Product systems",
    image: two,
    imageAlt:
      "Off-white electric city bike leaning against a warm plaster wall.",
  },
  {
    year: "2024",
    title: "Halla",
    description:
      "A compact electric device with careful power management, embedded firmware and industrial design ready for production.",
    category: "Hardware and embedded systems",
    image: three,
    imageAlt:
      "Compact grey device with a brushed aluminium dial and a small green status light.",
  },
];
---

<section class="scroll-mt-32" id="work">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-muted-foreground"
          >Selected work
          <br />
          2024 to now</Text
        >
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-medium leading-snug lg:col-span-2 text-foreground text-pretty"
      >
        Work
      </Text>
    </div>

    <div class="flex flex-col lg:gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase"
              >
                {project.year}
              </Text>
              <Text
                tag="h3"
                variant="displaySM"
                class="text-foreground leading-tight font-medium text-pretty"
              >
                {project.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-muted-foreground"
              >
                {project.description}
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase lg:ml-auto lg:col-start-4"
              >
                {project.category}
              </Text>
            </div>
            <div class="aspect-4/2 rounded-4xl mt-12 overflow-hidden">
              <Image
                width={1420}
                height={930}
                src={project.image}
                alt={project.imageAlt}
                loading="lazy"
                decoding="async"
                data-parallax
                class="size-full object-cover object-center scale-115 will-change-transform"
              />
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
