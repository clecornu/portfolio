---
// Assets
import { Image } from "astro:assets";
import one from "@/images/projects/one.png";
import two from "@/images/projects/two.png";
import three from "@/images/projects/three.png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const featuredProjects = [
  {
    year: "2025",
    title: "Domestic Grid",
    description:
      "A home systems planner that turns energy, climate and space into layouts, automation rules and a clear path for upgrades.",
    category: "Residential systems",
    image: one,
    imageAlt:
      "Modern home interior with overlaid system diagrams for energy, climate, and spatial planning.",
  },
  {
    year: "2024",
    title: "Type Pressure",
    description:
      "A study of rhythm, hierarchy and legibility when type is pushed to extreme size, density and motion on screen.",
    category: "Typography experiments",
    image: two,
    imageAlt:
      "High-contrast typographic compositions testing scale, spacing, and motion.",
  },
  {
    year: "2023",
    title: "Haul State",
    description:
      "Interface concepts for electric trucks: load awareness, range planning and the calls a driver makes on a long haul.",
    category: "Transport systems",
    image: three,
    imageAlt:
      "Electric truck cockpit interface showing load metrics, range estimates, and system status.",
  },
];
---

<section class="scroll-mt-32" id="projects">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-muted-foreground"
          >Side projects
          <br />
          2023 to now</Text
        >
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug tracking-tighter lg:col-span-2 text-foreground text-pretty"
      >
        Projects
      </Text>
    </div>

    <div class="flex flex-col gap-12 mt-8">
      {
        featuredProjects.map((project) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase"
              >
                {project.year}
              </Text>
              <Text
                tag="h3"
                variant="displaySM"
                class="text-foreground leading-tight font-semibold text-pretty"
              >
                {project.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-muted-foreground"
              >
                {project.description}
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase lg:ml-auto lg:col-start-4"
              >
                {project.category}
              </Text>
            </div>
            <Image
              width={1200}
              height={630}
              src={project.image}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
              class="size-full aspect-4/2 rounded-4xl mt-12 object-cover object-center"
            />
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
