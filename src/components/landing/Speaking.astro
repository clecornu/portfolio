---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
const speechesAndTalks = [
  {
    period: "2026",
    title: "Interface truths under constraint",
    description:
      "Designing UI when latency and imperfect data are the default, and still shipping something clear.",
    category: { label: "Product design", href: "#_" },
  },
  {
    period: "2026",
    title: "Typography as infrastructure",
    description:
      "Why type is not decoration: rhythm, hierarchy and density as tools for reading fast in complex interfaces.",
    category: { label: "Typography", href: "#_" },
  },
  {
    period: "2025",
    title: "State machines for humans",
    description:
      "Modelling UI states, edge cases and failures so products behave predictably under real pressure.",
    category: { label: "Engineering", href: "#_" },
  },
  {
    period: "2025",
    title: "Speed is a feature",
    description:
      "Skeletons, progressive disclosure and optimistic UI, and knowing when faking speed costs trust.",
    category: { label: "Performance", href: "#_" },
  },
  {
    period: "2024",
    title: "Design critique without mercy",
    description:
      "A way to critique that makes the work better: name the constraints, name the decisions, cut the ambiguity.",
    category: { label: "Practice", href: "#_" },
  },
];
---

<section class="scroll-mt-32" id="speaking">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-muted-foreground">
          Talks
          <br />
          Selected sessions
        </Text>
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-medium leading-snug tracking-tight lg:col-span-2 text-foreground text-pretty"
      >
        Speaking
      </Text>
    </div>
    <div class="flex flex-col gap-12 mt-12">
      {
        speechesAndTalks.map((item) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              {/* Year */}
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase"
              >
                {item.period}
                <br />
                {item.category.label}
              </Text>
              {/* Title */}
              <Text
                tag="h3"
                variant="textLG"
                class="text-foreground leading-tight font-medium tracking-tight text-pretty"
              >
                {item.title}
              </Text>
              {/* Description */}
              <Text
                tag="p"
                variant="textSM"
                class="text-muted-foreground"
              >
                {item.description}
              </Text>
              {/* Category (linked, original position) */}
              <a
                href={item.category.href}
                class=" lg:ml-auto text-foreground hover:text-muted-foreground transition"
              >
                <span class="sr-only"> Visit {item.category.label}</span>
                <ArrowRight class="size-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
