---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const education = [
  {
    period: "Ongoing",
    title: "Self directed study",
    description:
      "Long form study driven by primary sources, reverse engineering and experiments, rather than finished courses.",
    category: "Autodidactic",
  },
  {
    period: "Advanced",
    title: "Design and visual systems",
    description:
      "Typography, layout, proportion and hierarchy, with a focus on clear decisions made under constraint.",
    category: "Design",
  },
  {
    period: "Foundational",
    title: "Frontend engineering",
    description:
      "Component architecture, state, performance and accessibility in modern frontend systems.",
    category: "Software engineering",
  },
  {
    period: "Applied",
    title: "Systems thinking",
    description:
      "Feedback loops, second order effects and failure modes across technical and organisational systems.",
    category: "Systems theory",
  },
  {
    period: "Daily",
    title: "Typography and reading",
    description:
      "Reproducing and taking apart historical work to sharpen the eye, one iteration at a time.",
    category: "Craft",
  },
  {
    period: "Ongoing",
    title: "Critical reading and writing",
    description:
      "Reading across design, technology, philosophy and economics, and writing it down to think more precisely.",
    category: "Writing",
  },
];
---

<section class="scroll-mt-32" id="education">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-muted-foreground">
          Learning
          <br />
          Always ongoing
        </Text>
      </div>

      <Text
        tag="h2"
        variant="textXL"
        class="font-medium leading-snug lg:col-span-2 text-foreground text-pretty"
      >
        Education
      </Text>
    </div>

    <div class="flex flex-col gap-12 mt-12">
      {
        education.map((item) => (
          <article class="py-12 border-t border-muted">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase"
              >
                {item.period}
              </Text>

              <Text
                tag="h3"
                variant="textLG"
                class="text-foreground leading-tight font-medium text-pretty"
              >
                {item.title}
              </Text>

              <Text
                tag="p"
                variant="textSM"
                class="text-muted-foreground"
              >
                {item.description}
              </Text>

              <Text
                tag="p"
                variant="textXS"
                class="text-muted-foreground uppercase lg:ml-auto lg:col-start-4"
              >
                {item.category}
              </Text>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
