---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const links = [
  { href: "#frntdsk", text: "Frntdsk" },
  { href: "#machine-learning", text: "Machine learning" },
  { href: "#soccer", text: "Soccer" },
];
---

<nav class="bg-background fixed top-0 z-10 w-full">
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-2 lg:grid-cols-3 items-start">
      <a href="/" class="text-muted-foreground text-xs">Carson LeCornu</a>
      <Text tag="p" variant="textXS" class="text-muted-foreground">
        Walnut Creek, California
      </Text>
      <div class="hidden lg:flex gap-8 text-sm items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-muted-foreground text-xs hover:text-foreground transition-colors"
            >
              {link.text}
            </a>
          ))
        }
      </div>
    </div>
  </Wrapper>
</nav>
