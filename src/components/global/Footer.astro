---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const links = [
  { href: "#_", text: "LinkedIn" },
  { href: "#_", text: "Arena" },
  { href: "#_", text: "GitHub" },
];
const year = new Date().getFullYear();
---

<footer>
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-2 lg:grid-cols-4 items-start">
      <div
        class="flex items-center gap-2 text-muted-foreground text-xs"
      >
        {year}
        <Logo />
      </div>
      <div class="flex flex-wrap gap-8 text-sm items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-muted-foreground text-xs hover:text-foreground transition-colors"
            >
              {link.text}
            </a>
          ))
        }
      </div>
    </div>
  </Wrapper>
</footer>
